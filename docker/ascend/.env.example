# Actual image from your verified 310P aarch64 software stack.
ASCEND_BASE_IMAGE=yolo-ascend-sdk:310p3-test
ASCEND_DEVICE_ID=0
# Optional; empty if the base image already configures CANN.
ASCEND_ENV_SCRIPT=/usr/local/Ascend/ascend-toolkit/set_env.sh
# Replace CHANGE_ME with the MySQL password URL-encoded for a SQLAlchemy URL.
METADATA_DATABASE_URL=mysql+pymysql://admin:CHANGE_ME@mysql:3306/sp-ai-yolo?charset=utf8mb4
MYSQL_PUBLISHED_PORT=3306
MYSQL_DATA_DIR=/data/mysql/data
MYSQL_CONF_DIR=/data/mysql/conf
MYSQL_LOG_DIR=/data/mysql/logs
PUBLIC_HOST=192.168.1.179
ZLM_IMAGE=zlmediakit/zlmediakit:master
ZLM_HTTP_PORT=8010
ZLM_RTSP_PORT=554
ZLM_RTMP_PORT=1935
# Copy the [api] secret from ZLM; this variable does not change ZLM's config.
ZLM_SECRET=
BACKEND_PORT=8000
ELECTRONIC_SEAL_PORT=9001
