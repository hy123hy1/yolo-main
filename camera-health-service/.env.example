# Camera health service deployment-level configuration
CAMERA_HEALTH_MINE_CODE=000000000001
CAMERA_HEALTH_FRAME_WIDTH=1920
CAMERA_HEALTH_FRAME_HEIGHT=1080

# Person counting
CAMERA_HEALTH_PERSON_COUNT_MODEL_PATH=/app/camera-health-service/model/yolo11s.pt
CAMERA_HEALTH_PERSON_COUNT_INTERVAL_SECONDS=1.0
# Person-entry tracking/inference cadence; database writes happen only on crossings.
CAMERA_HEALTH_PERSON_ENTRY_INTERVAL_SECONDS=0.2
# Database write heartbeat; inference frequency above remains unchanged.
CAMERA_HEALTH_PERSON_COUNT_RECORD_INTERVAL_SECONDS=300
CAMERA_HEALTH_PERSON_COUNT_RETENTION_DAYS=180
CAMERA_HEALTH_PERSON_COUNT_CLEANUP_INTERVAL_SECONDS=86400
CAMERA_HEALTH_PERSON_COUNT_CONFIDENCE=0.6
CAMERA_HEALTH_PERSON_COUNT_IMAGE_SIZE=640
CAMERA_HEALTH_PERSON_COUNT_DEVICE=cuda:0
CAMERA_HEALTH_PERSON_COUNT_SNAPSHOT_DIR=/app/data/camera_health/person_count
CAMERA_HEALTH_PERSON_COUNT_RUN_DIR=/tmp/camera_health/person_count/runs
YOLO_CONFIG_DIR=/tmp

# WVP and FFmpeg transient network retry limits
WVP_RETRY_ATTEMPTS=3
WVP_RETRY_BACKOFF_SECONDS=1
CAMERA_HEALTH_STREAM_RECONNECT_MAX_DELAY_SECONDS=30
CAMERA_HEALTH_VIDEO_LOSS_ALARM_HOLD_SECONDS=5
CAMERA_HEALTH_VIDEO_LOSS_RECOVERY_HOLD_SECONDS=5

# Baseline calibration quality and stable-candidate collection
CAMERA_HEALTH_BASELINE_STABLE_FRAMES=10
CAMERA_HEALTH_BASELINE_WARMUP_SECONDS=5
CAMERA_HEALTH_BASELINE_CANDIDATE_FRAMES=5
CAMERA_HEALTH_BASELINE_MAX_CAPTURE_ATTEMPTS=12
CAMERA_HEALTH_BASELINE_SAMPLE_INTERVAL_SECONDS=0.4
CAMERA_HEALTH_BASELINE_MAX_FRAME_DIFFERENCE=0.12

# Health detector sampling intervals (seconds)
CAMERA_HEALTH_OCCLUSION_INTERVAL_SECONDS=2
CAMERA_HEALTH_VIEW_SHIFT_INTERVAL_SECONDS=5
CAMERA_HEALTH_BLUR_INTERVAL_SECONDS=3
CAMERA_HEALTH_EXPOSURE_INTERVAL_SECONDS=3
CAMERA_HEALTH_FREEZE_INTERVAL_SECONDS=1
CAMERA_HEALTH_VIDEO_LOSS_INTERVAL_SECONDS=1
CAMERA_HEALTH_SHAKE_INTERVAL_SECONDS=2
CAMERA_HEALTH_RESOLUTION_INTERVAL_SECONDS=30
